{
  "permissions": {
    "allow": [
      "Bash(chmod:*)",
      "Bash(tasklist.exe:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./src/hooks/notify_hook.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./src/hooks/stop_hook.py\""
          }
        ]
      }
    ]
  }
}
